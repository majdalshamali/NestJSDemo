# Arcjet site key — get yours at https://app.arcjet.com
# Copy this file to .env and fill in the value. Never commit .env.
ARCJET_KEY=

# LIVE = rules actually block. DRY_RUN = log only, nothing is blocked.
ARCJET_MODE=LIVE

# Lets Arcjet work with private/localhost IPs during local development
ARCJET_ENV=development

# Prisma Postgres connection string (from console.prisma.io)
DATABASE_URL=
